<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="নিরাপত্তা সেটিংস"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- App Lock Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="App Lock চালু করো"
                android:textColor="#FFFFFF"
                android:textSize="18sp"/>

            <Switch
                android:id="@+id/appLockSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/appLockStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔓 App Lock বন্ধ"
            android:textColor="#888888"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/selectAppsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="কোন Apps লক করতে চাও সিলেক্ট করো"
            android:textAllCaps="false"
            android:layout_marginBottom="24dp"/>

        <!-- Permissions Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions দরকার"
            android:textColor="#FF1744"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/usageStatsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usage Stats অনুমতি দাও"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/overlayPermissionBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apps উপরে Display অনুমতি দাও"
            android:textAllCaps="false"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="24dp"/>

        <!-- PIN Section -->
        <Button
            android:id="@+id/setPinBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PIN সেট / পরিবর্তন করো"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/pinStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌ PIN সেট নেই"
            android:textColor="#888888"
            android:layout_marginBottom="16dp"/>

        <!-- Pattern Section -->
        <Button
            android:id="@+id/setPatternBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pattern সেট করো"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/patternStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌ Pattern সেট নেই"
            android:textColor="#888888"
            android:layout_marginBottom="16dp"/>

        <!-- Voice Section -->
        <Button
            android:id="@+id/setVoiceBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voice Passphrase সেট করো"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌ সেট নেই"
            android:textColor="#888888"
            android:layout_marginBottom="24dp"/>

        <!-- Biometric Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fingerprint Unlock"
                android:textColor="#FFFFFF"
                android:textSize="18sp"/>

            <Switch
                android:id="@+id/fingerprintSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- System Lock Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Device Screen Lock ব্যবহার করো"
                android:textColor="#FFFFFF"
                android:textSize="18sp"/>

            <Switch
                android:id="@+id/deviceLockSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="24dp"/>

        <!-- প্রাইভেট মোড Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="প্রাইভেট মোড"
                android:textColor="#FFFFFF"
                android:textSize="18sp"/>

            <Switch
                android:id="@+id/privateModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/privateModeStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁️ প্রাইভেট মোড OFF"
            android:textColor="#888888"
            android:layout_marginBottom="24dp"/>

        <!-- Encryption Status -->
        <TextView
            android:id="@+id/encryptionStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐 AES-256-GCM (Android Keystore) — Always ON"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>
